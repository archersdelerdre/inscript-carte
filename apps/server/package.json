{
  "name": "@inscript-carte/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --external=knex --external=better-sqlite3",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:import-legacy-events": "bun src/infrastructure/database/import-legacy-events.ts",
    "db:import-archers": "bun src/infrastructure/database/import-archers.ts",
    "db:add-admin": "bun src/infrastructure/database/add-admin.ts",
    "db:remove-admin": "bun src/infrastructure/database/remove-admin.ts"
  },
  "dependencies": {
    "@inscript-carte/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.3.0",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
