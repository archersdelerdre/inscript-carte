{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CHROME_PATH",
        "PORT",
        "DATABASE_PATH",
        "API_URL",
        "OPENROUTER_API_KEY",
        "MANDATE_MODEL",
        "MANDATE_FALLBACK_MODEL"
      ]
    }
  }
}
